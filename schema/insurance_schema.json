      {
        "name": "insurance_type",
        "description": "保险类型",
        "is_categorical": false,
        "possible_values": []
      }
    ],
    "intents": [
      {
        "name": "verify_member_identity",
        "description": "核实客户身份，确认是否为生活协同组合会员",
        "is_transactional": false,
        "required_slots": [],
        "optional_slots": ["customer_age_range", "customer_gender"],
        "result_slots": ["identity_verified"]
      },
      {
        "name": "introduce_product",
        "description": "介绍团体癌症保险产品特点、保障范围及优惠政策",
        "is_transactional": false,
        "required_slots": [],
        "optional_slots": ["insurance_type"],
        "result_slots": ["product_info"]
      },
      {
        "name": "calculate_premium",
        "description": "计算保费，根据客户年龄、性别和选择的保额",
        "is_transactional": false,
        "required_slots": [],
        "optional_slots": ["customer_age_range", "customer_gender", "budget_range"],
        "result_slots": ["premium_amount"]
      },
      {
        "name": "handle_objection",
        "description": "处理客户异议，针对价格、必要性、信任等顾虑给出专业解答",
