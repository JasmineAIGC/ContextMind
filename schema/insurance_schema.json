      },
      {
        "name": "intent_level2",
        "description": "二级意图（子意图）",
        "is_categorical": false,
        "possible_values": []
      },
      {
        "name": "intent_level3",
        "description": "三级意图（详细信息，基于用户对话模式提取）",
        "is_categorical": false,
        "possible_values": []
      },
      {
        "name": "customer_age_range",
        "description": "客户年龄段",
        "is_categorical": true,
        "possible_values": ["30岁以下", "30-40岁", "40-50岁", "50岁以上"]
