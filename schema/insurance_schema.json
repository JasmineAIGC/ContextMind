        "required_slots": ["intent_level1"],
        "optional_slots": ["intent_level2", "intent_level3"],
        "result_slots": ["objection_handled"]
      },
      {
        "name": "compare_with_existing_insurance",
        "description": "与客户现有保险对比，说明补充保障的价值",
        "is_transactional": false,
        "required_slots": [],
        "optional_slots": ["has_insurance", "has_cancer_insurance", "insurance_type"],
