      {
        "name": "schedule_callback",
        "description": "安排后续回访时间，适用于客户需要考虑或与家人商量的情况",
        "is_transactional": true,
        "required_slots": [],
        "optional_slots": ["callback_needed", "decision_maker"],
        "result_slots": ["callback_scheduled"]
      },
      {
        "name": "close_sale",
        "description": "促成成交，引导客户完成电话投保流程",
        "is_transactional": true,
        "required_slots": [],
        "optional_slots": ["customer_age_range", "customer_gender", "budget_range"],
        "result_slots": ["sale_completed"]
      },
      {
        "name": "end_call_gracefully",
        "description": "礼貌结束通话，适用于客户明确拒绝或当前不方便的情况",
        "is_transactional": false,
        "required_slots": [],
        "optional_slots": ["callback_needed"],
        "result_slots": ["call_ended"]
      }
    ]
  }
