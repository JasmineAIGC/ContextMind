# ContextMind v0.4.1 配置文件示例 (ADK 优化版)
# 
# 使用 Google ADK-Python 框架
# 
# 快速开始:
# 1. 复制此文件为 .env
# 2. 配置 API Key
# 3. 运行: python interactive_demo.py 或 python gradio_demo.py

# ========================================
# LLM 配置 (通过 ADK + LiteLLM)
# ========================================

# 选项 1: 使用 Google Gemini (推荐)
GOOGLE_API_KEY=your-google-api-key-here
MODEL=gemini-2.0-flash-exp

# 选项 2: 使用 OpenAI
# OPENAI_API_KEY=your-openai-key
# MODEL=openai/gpt-4

# 选项 3: 使用 Anthropic Claude
# ANTHROPIC_API_KEY=your-anthropic-key
# MODEL=anthropic/claude-3-sonnet

# 选项 4: 使用其他兼容提供商
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=http://your-endpoint/v1
# MODEL=your-model-name

# ========================================
# 高级配置
# ========================================
# LLM 温度参数 (0.0-1.0)
TEMPERATURE=0.7

# 最大输出 tokens
MAX_TOKENS=8192

# ========================================
# 向量数据库配置
# ========================================
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ========================================
# Embedding 配置 (可选)
# ========================================
# 如果使用本地 embedding 模型
# EMBEDDING_MODEL_PATH=/path/to/your/model
# EMBEDDING_MODEL=bge-large-zh-v1.5
