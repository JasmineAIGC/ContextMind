# ContextMind 配置示例
# 复制此文件为 .env 并填入实际配置值

# ==================== LLM 配置 ====================
# LLM 服务配置（用于对话和知识提取）
LLM_MODEL=Qwen3-32B
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=your-llm-api-key

# 或使用 QWEN3 配置
# QWEN3_MODEL=Qwen3-32B
# QWEN3_BASE_URL=http://localhost:8000/v1
# QWEN3_API_KEY=your-qwen3-api-key

# 或使用 OpenAI 配置
# OPENAI_MODEL=gpt-4
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your-openai-api-key

# ==================== Embedding 配置 ====================
# 推荐方式 1：本地加载 embedding 模型（无需部署服务，性能最佳）
# 需要安装：pip install sentence-transformers
EMBEDDING_MODEL_PATH=/share/airesearch/data/aowen.xiao/models/BAAI/bge-large-zh-v1.5
EMBEDDING_MODEL=bge-large-zh-v1.5

# 方式 2：通过 API 调用 embedding 服务（需要部署 vLLM embedding 服务）
# EMBEDDING_MODEL=bge-large-zh-v1.5
# EMBEDDING_BASE_URL=http://localhost:8001/v1
# EMBEDDING_API_KEY=EMPTY

# 方式 3：不配置专门的 embedding（将使用 LLM 配置作为回退）
# 注意：某些 LLM 可能不支持 embedding 生成

# ==================== 可选配置 ====================
# 访问密钥（某些网关需要）
# LLM_ACCESS_KEY=your-access-key
# EMBEDDING_ACCESS_KEY=your-access-key

# ==================== 配置说明 ====================
# 1. EMBEDDING_MODEL_PATH 优先级最高，如果配置则使用本地模型
# 2. 如果未配置 EMBEDDING_MODEL_PATH，则检查 EMBEDDING_BASE_URL 是否配置
# 3. 如果都未配置，则使用 LLM 配置作为 embedding 服务（需要 LLM 支持 embedding）
# 4. 本地加载模式无需额外服务，性能最优，推荐使用

# ==================== vLLM 部署示例 ====================
# 启动 LLM 服务：
# python -m vllm.entrypoints.openai.api_server \
#     --model /path/to/Qwen3-32B \
#     --port 8000

# 启动 Embedding 服务（可选，如使用本地加载则不需要）：
# python -m vllm.entrypoints.openai.api_server \
#     --model /share/airesearch/data/aowen.xiao/models/BAAI/bge-large-zh-v1.5 \
#     --port 8001 \
#     --is-embedding
