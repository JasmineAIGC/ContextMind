# ContextMind v0.5.0 配置文件示例 (ADK-powered)
# 
# ADK 优化版本 - 使用 Google GenAI SDK
# 
# 快速开始:
# 1. 复制此文件为 .env
# 2. 填写下面的 GOOGLE_API_KEY
# 3. 运行: python interactive_demo.py 或 python gradio_demo.py

# ========================================
# Google GenAI API 配置 (推荐 - v0.5.0)
# ========================================
# 获取 API Key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-2.0-flash-exp

# ========================================
# 向后兼容 - 传统 LLM 配置
# ========================================
# 如果不使用 Google GenAI，可以使用以下配置
# QWEN3_API_KEY=sk-your-api-key-here
# QWEN3_BASE_URL=http://your-api-endpoint/v1
# QWEN3_MODEL=Qwen3-32B

# ========================================
# 高级配置
# ========================================
# LLM 温度参数 (0.0-1.0)
LLM_TEMPERATURE=0.7

# 最大输出 tokens
MAX_TOKENS=8192

# Top-p 采样参数
TOP_P=0.95

# Top-k 采样参数
TOP_K=40

# ========================================
# Embedding 配置 (可选)
# ========================================
# 如果使用本地 embedding 模型
# EMBEDDING_MODEL_PATH=/path/to/your/model
# EMBEDDING_MODEL=bge-large-zh-v1.5
