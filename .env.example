# ContextMind v0.4.1 配置文件示例
# 
# 快速开始:
# 1. 复制此文件为 .env
# 2. 配置 LLM API Key
# 3. 运行: python interactive_demo.py 或 python gradio_demo.py

# ========================================
# LLM 配置（当前使用 Qwen 模型）
# ========================================

QWEN3_API_KEY=your-api-key
QWEN3_BASE_URL=http://your-endpoint/v1
QWEN3_MODEL=Qwen2.5-7B-Instruct
QWEN3_TOP_K=20
QWEN3_MAX_TOKENS=8192

# 或者使用通用配置
# LLM_API_KEY=your-api-key
# LLM_BASE_URL=http://your-endpoint/v1
# LLM_MODEL=Qwen2.5-7B-Instruct
# LLM_TOP_K=20
# LLM_MAX_TOKENS=8192

# ========================================
# 向量数据库配置
# ========================================
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ========================================
# Embedding 配置（使用专门的嵌入模型，不是 LLM）
# ========================================
# 选项 1: 使用本地 embedding 模型（推荐，速度快）
# EMBEDDING_MODEL_PATH=/path/to/your/model
# EMBEDDING_MODEL=bge-large-zh-v1.5
# 
# 选项 2: 使用 API 部署的 embedding 模型（如 vLLM）
# EMBEDDING_MODEL=bge-large-zh-v1.5
# EMBEDDING_BASE_URL=http://localhost:8001/v1
# EMBEDDING_API_KEY=your-key  # 可选
