# ContextMind LLM Configuration
# 复制此文件为 .env 并填入实际的API密钥

# 方式1: 使用Qwen3配置（推荐）
QWEN3_API_KEY=sk-your-api-key-here
QWEN3_BASE_URL=http://10.112.172.30:18019/v1
QWEN3_MODEL=Qwen3-32B

# 方式2: 使用通用LLM配置
# LLM_API_KEY=sk-your-api-key-here
# LLM_BASE_URL=http://your-api-endpoint/v1
# LLM_MODEL=your-model-name

# 方式3: 使用OpenAI配置
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-3.5-turbo

# 注意：只需要配置一种方式即可
# API_KEY 是必需的，BASE_URL 和 MODEL 可选（有默认值）
