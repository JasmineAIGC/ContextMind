# ContextMind 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ============================================
# LLM API 配置 (必需)
# ============================================

# Qwen 模型配置 (推荐)
QWEN3_API_KEY=your-api-key-here
QWEN3_BASE_URL=http://your-api-endpoint/v1
QWEN3_MODEL=Qwen3-32B
QWEN3_TEMPERATURE=0.6
QWEN3_MAX_TOKENS=8192
QWEN3_TOP_K=20

# 或者使用 OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4
# OPENAI_TEMPERATURE=0.6
# OPENAI_MAX_TOKENS=4096

# 或者使用 DeepSeek
# DEEPSEEK_API_KEY=your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TEMPERATURE=0.6
# DEEPSEEK_MAX_TOKENS=4096

# 或者使用通用 LLM 配置
# LLM_API_KEY=your-api-key
# LLM_BASE_URL=http://your-endpoint/v1
# LLM_MODEL=your-model-name
# LLM_TEMPERATURE=0.6
# LLM_MAX_TOKENS=4096

# ============================================
# 应用配置 (可选)
# ============================================

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# 日志文件路径
# LOG_FILE=logs/contextmind.log

# 是否输出到控制台
# LOG_TO_CONSOLE=true

# ============================================
# Gradio UI 配置 (可选)
# ============================================

# Web 服务端口
# GRADIO_SERVER_PORT=7860

# 是否允许公网访问
# GRADIO_SERVER_NAME=0.0.0.0

# 是否启用认证
# GRADIO_AUTH_USERNAME=admin
# GRADIO_AUTH_PASSWORD=password

# ============================================
# 引擎配置 (可选)
# ============================================

# 短期记忆保留事件数
# SHORT_TERM_MAX_EVENTS=6

# 长期记忆保留事件数
# LONG_TERM_MAX_EVENTS=50

# 定期总结间隔（轮次）
# SUMMARY_INTERVAL=5

# ============================================
# 开发配置 (可选)
# ============================================

# 开发模式
# DEV_MODE=false

# 调试模式
# DEBUG=false

# 显示详细 Prompt
# SHOW_PROMPT=false

# 显示上下文信息
# SHOW_CONTEXT=false
