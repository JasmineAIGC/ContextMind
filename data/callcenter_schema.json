[
  {
    "service_name": "CallCenter_Service",
    "description": "通用客服对话场景，处理产品咨询、投诉、售后、账户管理、物流查询等服务请求",
    "slots": [
      {
        "name": "issue_type",
        "description": "问题类型（产品问题/服务问题/物流问题/账户问题等）",
        "is_categorical": true,
        "possible_values": ["产品问题", "服务问题", "物流问题", "账户问题", "其他"]
      },
      {
        "name": "order_id",
        "description": "订单编号",
        "is_categorical": false,
        "possible_values": []
      },
      {
        "name": "product_name",
        "description": "产品名称或型号",
        "is_categorical": false,
        "possible_values": []
      },
      {
        "name": "account_id",
        "description": "账户ID或用户名",
        "is_categorical": false,
        "possible_values": []
      },
      {
        "name": "complaint_description",
        "description": "投诉内容描述",
        "is_categorical": false,
        "possible_values": []
      },
      {
        "name": "service_type",
        "description": "服务类型（退换货/维修/质保/使用指导等）",
        "is_categorical": true,
        "possible_values": ["退货", "换货", "维修", "质保", "使用指导"]
      },
      {
        "name": "tracking_number",
        "description": "快递单号",
        "is_categorical": false,
        "possible_values": []
      },
      {
        "name": "refund_amount",
