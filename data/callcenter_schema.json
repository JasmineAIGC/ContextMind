        "is_categorical": false,
        "possible_values": []
      },
      {
        "name": "new_email",
        "description": "新邮箱地址",
        "is_categorical": false,
        "possible_values": []
      },
      {
        "name": "new_phone",
        "description": "新手机号",
        "is_categorical": false,
        "possible_values": []
      },
      {
        "name": "feedback_content",
        "description": "用户反馈或建议内容",
        "is_categorical": false,
        "possible_values": []
      }
    ],
    "intents": [
      {
        "name": "query_order_status",
        "description": "查询订单状态，包括支付状态、发货状态和预计到达时间",
        "is_transactional": false,
        "required_slots": ["order_id"],
        "optional_slots": [],
        "result_slots": ["order_status"]
      },
      {
        "name": "submit_complaint",
        "description": "提交投诉，记录问题类型和详细描述",
        "is_transactional": true,
        "required_slots": ["complaint_description"],
        "optional_slots": ["issue_type", "order_id", "product_name"],
        "result_slots": ["complaint_id"]
      },
      {
        "name": "request_refund",
        "description": "申请退款，支持全额和部分退款",
        "is_transactional": true,
        "required_slots": ["order_id"],
        "optional_slots": ["refund_amount", "complaint_description"],
        "result_slots": ["refund_status"]
      },
      {
        "name": "request_exchange",
        "description": "申请换货，需要订单号和问题描述",
        "is_transactional": true,
        "required_slots": ["order_id"],
        "optional_slots": ["product_name", "complaint_description"],
        "result_slots": ["exchange_status"]
      },
      {
        "name": "track_logistics",
        "description": "查询物流配送状态和快递轨迹",
        "is_transactional": false,
        "required_slots": ["tracking_number"],
        "optional_slots": ["order_id"],
        "result_slots": ["logistics_status"]
      },
      {
        "name": "reset_password",
        "description": "重置账户密码，需要账户ID验证",
        "is_transactional": true,
        "required_slots": ["account_id"],
        "optional_slots": [],
        "result_slots": ["reset_status"]
      },
      {
        "name": "update_account_info",
        "description": "修改账户信息，如邮箱、手机号等",
        "is_transactional": true,
        "required_slots": ["account_id"],
        "optional_slots": ["new_email", "new_phone"],
        "result_slots": ["update_status"]
      },
      {
        "name": "query_service_policy",
        "description": "查询售后政策、退换货规则、质保期限等",
        "is_transactional": false,
        "required_slots": [],
        "optional_slots": ["product_name", "service_type"],
        "result_slots": ["policy_info"]
      },
      {
        "name": "submit_feedback",
        "description": "提交用户反馈或建议",
        "is_transactional": true,
        "required_slots": ["feedback_content"],
        "optional_slots": [],
        "result_slots": ["feedback_id"]
      }
    ]
  }
]
