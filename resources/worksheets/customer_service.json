{
  "service_name": "客服工单系统",
  "description": "演示 depends_on 条件依赖字段和 on_success API 调用",
  "intents": [
    {
      "name": "submit_ticket",
      "description": "提交客服工单",
      "is_transactional": true,
      "policy_fields": [
        {
          "name": "category",
          "type": "enum",
          "description": "问题类别",
          "required": true,
          "confirm": false,
          "ask_by_system": true,
          "depends_on": "",
          "possible_values": ["账单问题", "技术故障", "配送问题", "退款申请", "其他"],
          "on_success": ""
        },
        {
          "name": "order_id",
          "type": "str",
          "description": "相关订单号（如有）",
          "required": false,
          "confirm": false,
          "ask_by_system": true,
          "depends_on": "category",
          "possible_values": [],
          "on_success": ""
        },
        {
          "name": "description",
          "type": "str",
          "description": "问题详细描述",
          "required": true,
          "confirm": false,
          "ask_by_system": true,
          "depends_on": "",
          "possible_values": [],
          "on_success": ""
        },
        {
          "name": "contact_email",
          "type": "str",
          "description": "联系邮箱",
          "required": true,
          "confirm": true,
          "ask_by_system": true,
          "depends_on": "",
          "possible_values": [],
          "on_success": ""
        },
        {
          "name": "priority",
          "type": "enum",
          "description": "紧急程度",
          "required": false,
          "confirm": false,
          "ask_by_system": false,
          "depends_on": "",
          "possible_values": ["低", "中", "高", "紧急"],
          "on_success": "submit_ticket_api"
        }
      ]
    }
  ]
}
